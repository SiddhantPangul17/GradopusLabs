# Gradopus Labs environment variables
#
# Copy this file to `.env.local` and fill in values. `.env.local` is ignored by
# Git: never commit real credentials.
#
# Empty values are treated as unset. Values that are set are validated in
# src/lib/env.ts. See docs/database-setup.md for MongoDB Atlas setup.
#
# All variables here are server-only. Never rename them with a NEXT_PUBLIC_
# prefix: that would inline them into the browser bundle.

# Canonical public URL of the site, with no trailing path (this project's
# equivalent of an "app URL"; it is read on the server only).
# Used for metadata now; for absolute links such as certificate verification
# URLs and QR codes later. Defaults to http://localhost:3000 when unset.
# Set this in every deployed environment.
SITE_URL=

# MongoDB Atlas connection string (mongodb+srv://...). Includes the database
# user's password, so treat it as a secret.
# - Development: optional. Without it, `npm run dev` shows sample programs.
# - Production: required. Without it, the program catalogue is empty and
#   /api/health reports the database as not configured.
MONGODB_URI=

# Database name inside the cluster. Defaults to "krushitech".
MONGODB_DB_NAME=krushitech

# Optional. Only if the app reports "this computer's DNS server refused the cluster
# lookup": some Windows networks make Node.js query 127.0.0.1 for DNS, which breaks
# mongodb+srv:// addresses. List public DNS servers to use for that lookup instead.
# Leave empty on hosting providers (not needed there).
MONGODB_DNS_SERVERS=

# Secret that encrypts session cookies (Auth.js). At least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required for accounts: without it (and MONGODB_URI), sign-in is disabled.
# Use a different value per environment; changing it signs everyone out.
AUTH_SECRET=

# Auth.js only trusts the request host in development. In production set
# AUTH_TRUST_HOST=true when behind a trusted proxy/host (most managed hosts),
# or set AUTH_URL to the site's public URL. (Not needed on Vercel.)
AUTH_TRUST_HOST=
AUTH_URL=

# Optional default account for `npm run admin:grant` (see docs/authentication.md).
# The account must already exist; nothing is created automatically.
ADMIN_EMAIL=admin@example.com

# ---------- Online payments (docs/payments.md) ----------
# Leave PAYMENT_PROVIDER empty to keep online payments switched off (the
# checkout then says payments are unavailable; nothing is simulated).
# Only "razorpay" is implemented. Using it requires an approved Razorpay
# merchant account for live payments; test keys work without approval.
PAYMENT_PROVIDER=

# "test" (default) or "live". Keys alone NEVER enable live payments: live mode
# needs PAYMENT_MODE=live AND live keys (rzp_live_…). A mismatch (e.g. live keys
# with test mode) disables payments and logs a configuration error.
# Use separate test and live keys per environment; never copy live keys to dev.
PAYMENT_MODE=test

# API key id and secret from the Razorpay Dashboard (Test or Live mode).
# The key id is public (sent to the browser for Checkout); the secret is not.
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=

# Secret you choose when creating the webhook in the Razorpay Dashboard
# (URL: <SITE_URL>/api/webhooks/payment). Different from the key secret.
PAYMENT_WEBHOOK_SECRET=

# ---------- Certificates (docs/certificates.md) ----------
# 32 random bytes, base64. Encrypts each certificate's verification token at rest
# (only a hash is used for lookups) so the PDF and its QR code can be regenerated.
# Required to ISSUE certificates; public verification works without it.
# Generate once:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it secret and backed up; never rotate it casually (old PDFs could no longer
# be regenerated with their QR code, though verification keeps working).
# Certificates also require SITE_URL (https) in production: QR codes point to it.
CERTIFICATE_TOKEN_KEY=

# ---------- Email (docs/notifications.md) ----------
# Leave EMAIL_PROVIDER empty to keep email off: messages stay queued and nothing
# is reported as sent. Only "resend" is implemented. A sending domain must be
# verified with the provider (DNS records) before real delivery.
EMAIL_PROVIDER=
# Provider API key (server only).
EMAIL_API_KEY=
# Sender on a VERIFIED domain, e.g.  Gradopus Labs <noreply@mail.your-domain.example>
EMAIL_FROM=
# Optional monitored reply address.
EMAIL_REPLY_TO=
# Bearer secret for the scheduled outbox processor (/api/notifications/process).
# 32+ random characters; set the same value in your scheduler (e.g. Vercel Cron's CRON_SECRET).
CRON_SECRET=
